# Website origin (replace with the deployed HTTPS URL in production)
SITE_URL=http://localhost:4321

# Existing public Sanity content dataset. Never store visitor emails here.
SANITY_ENABLED=true
SANITY_PROJECT_ID=lrx8bnhn
SANITY_DATASET=production

# Public GTM container identifier.
NEXT_PUBLIC_GTM_ID=GTM-PN3S43P3

# Permanent form storage. This dataset must be private and separate from production.
NEWSLETTER_STORAGE=sanity
SANITY_SUBMISSIONS_DATASET=submissions
# Server-only robot token: never prefix with NEXT_PUBLIC_ or SANITY_STUDIO_.
SANITY_WRITE_TOKEN=

# Optional alternative storage: set NEWSLETTER_STORAGE=webhook to use these.
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
# For offline development only, NEWSLETTER_STORAGE=local uses .data/newsletter.ndjson.
