    "@types/react": "19.2.18",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
